# =====================================================================
# SecureVault - Environment Variables Configuration Template
# Copy this file to .env and supply your environment-specific secrets.
# NEVER commit your production .env or secret keys to version control.
# =====================================================================

# Server Port
SERVER_PORT=8080

# Database Configuration (MySQL 8+)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/securevault_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_secure_db_password_here

# Cryptographic Master Key (AES-256-GCM)
# MUST be a 256-bit key represented as exactly 64 hexadecimal characters.
# Generate on Linux/macOS with: openssl rand -hex 32
# Generate on PowerShell with: -join ((1..32) | ForEach-Object { '{0:x2}' -f (Get-Random -Maximum 256) })
VAULT_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Security & Lockout Parameters
VAULT_SECURITY_MAX_FAILED_ATTEMPTS=5
VAULT_SECURITY_LOCKOUT_MINUTES=15
